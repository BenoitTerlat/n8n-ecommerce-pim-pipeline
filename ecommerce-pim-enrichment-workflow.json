    {
      "parameters": {
        "jsCode": "// Récupère la liste brute des URLs extraites\nconst rawUrls = $json.product_url || [];\n\n// Dédoublonnage et filtrage (conserve uniquement les URLs valides contenant .html)\nconst uniqueUrls = [...new Set(rawUrls)].filter(url => \n  url && \n  typeof url === 'string' && \n  url.endsWith('.html') && \n  !url.includes('customer') && \n  !url.includes('checkout')\n);\n\n// Renvoie chaque URL sous forme d'un item distinct pour n8n\nreturn uniqueUrls.map(url => ({\n  json: {\n    target_url: url\n  }\n}));"
      },
