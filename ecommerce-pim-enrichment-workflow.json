      "name": "Extract Product Elements"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "qwen3:8b",
          "mode": "list",
          "cachedResultName": "qwen3:8b"
        },
        "messages": {
          "values": [
            {}
          ]
        },
        "options": {
          "system": "=Tu es un expert du textile et du e-commerce. Analyse les informations du produit suivant et extrait les caractéristiques sous forme d'un objet JSON strict.\n\nTitre du produit : {{ $json.product_name }}\nDescription : {{ $json.description_raw }}\n\nFormat de réponse attendu (uniquement le JSON, aucun commentaire, aucun markdown en dehors du bloc) :\n{\n  \"matiere_tissage\": [\"ex: Percale de coton\", \"Satin de coton\", \"Lin lavé\", etc.],\n  \"labels_certifications\": [\"ex: Origine France Garantie\", \"Oeko-Tex\", \"Coton biologique\", \"GOTS\", etc.],\n  \"typologie\": \"ex: Parure de couette, Drap housse, Taie d'oreiller, Couette\",\n  \"points_cles\": \"Résumé concis en une phrase des atouts du produit\"\n}",
          "format": "json"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        448,
        32
      ],
      "id": "fba92f24-4ff2-470d-8b32-1711a3e60e42",
      "name": "Message a model",
      "credentials": {
        "ollamaApi": {
          "id": "ollama-credential-id",
          "name": "Ollama account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Récupération des entrées\nconst items = $input.all();\nconst htmlItems = $('Extract Product Elements').all();\nconst urlItems = $('Deduplicate URLs').all();\n\n// Taxonomie officielle du catalogue\nconst TAXONOMY = {\n  \"Linge de lit\": [\"Parures de lit\", \"Parure de lit\", \"Housses de couette\", \"Housse de couette\", \"Taies d'oreiller\", \"Taie d'oreiller\", \"Draps housses\", \"Drap housse\"],\n  \"Linge de table\": [\"Nappes\", \"Nappe\", \"Torchons\", \"Torchon\", \"Serviettes de table\", \"Serviette de table\", \"Tabliers\", \"Tablier\", \"Sets de table\", \"Set de table\"],\n  \"Literie\": [\"Pack literie -10%\", \"Pack literie\", \"Couettes\", \"Couette\", \"Oreillers\", \"Oreiller\"]\n};\n\nreturn items.map((item, index) => {\n  const rawResponse = item.json.content || '';\n  const htmlData = htmlItems[index]?.json || {};\n  const targetUrl = urlItems[index]?.json?.target_url || '';\n\n  // 1. Parsing JSON LLM\n  let aiData = {};\n  try {\n    const cleaned = rawResponse.replace(/```json/g, '').replace(/```/g, '').trim();\n    aiData = JSON.parse(cleaned);\n  } catch (e) {\n    aiData = {\n      matiere_tissage: [],\n      labels_certifications: [],\n      typologie: \"\",\n      points_cles: \"\"\n    };\n  }\n\n  // 2. Nom produit et prix\n  const productName = htmlData.product_name || htmlData.nom_du_produit || 'Produit sans titre';\n  const rawPrice = htmlData.price_raw || htmlData.prix_brut || '';\n  let cleanPrice = null;\n  if (rawPrice) {\n    const match = rawPrice.replace(/\\s/g, '').replace(',', '.').match(/[\\d.]+/);\n    cleanPrice = match ? parseFloat(match[0]) : null;\n  }\n\n  // 3. Déduction stricte Rayon (Niveau 1) et Sous-rayon (Niveau 2)\n  const fullTextToInspect = [\n    htmlData.breadcrumb_raw || '',\n    targetUrl,\n    productName,\n    aiData.typologie || ''\n  ].join(' ').toLowerCase();\n\n  let detectedRayon = \"Linge de lit\";\n  let detectedSousRayon = \"Parures de lit\";\n\n  let matchFound = false;\n  for (const [rayon, subList] of Object.entries(TAXONOMY)) {\n    for (const sub of subList) {\n      if (fullTextToInspect.includes(sub.toLowerCase())) {\n        detectedRayon = rayon;\n        detectedSousRayon = sub;\n        matchFound = true;\n        break;\n      }\n    }\n    if (matchFound) break;\n  }\n\n  return {\n    json: {\n      nom_produit: productName,\n      url_produit: targetUrl,\n      prix_ttc: cleanPrice,\n      image_url: htmlData.image_url || '',\n      fil_ariane_brut: htmlData.breadcrumb_raw || '',\n      rayon_nom: detectedRayon,\n      sous_rayon_nom: detectedSousRayon,\n      matiere_tissage: aiData.matiere_tissage || [],\n      labels_certifications: aiData.labels_certifications || [],\n      typologie: aiData.typologie || \"\",\n      points_cles: aiData.points_cles || \"\",\n      description_brute: htmlData.description_raw || \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
